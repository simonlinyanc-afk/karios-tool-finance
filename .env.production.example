NODE_ENV=production
# Node 只监听本机回环地址；公网流量必须先经过 Nginx。
HOST=127.0.0.1
PORT=3000
# 仅作为 Node 运行时内部访问值；真实值不得写入 HTML、JS、构建变量、镜像层或仓库。
# 使用密码生成器创建足够长的随机值，并与 Nginx 外置 snippet 中的值保持一致。
# 此处只能保留占位符。
OCR_ACCESS_TOKEN=replace-with-a-long-random-internal-value
QWEN_API_KEY=replace-with-dashscope-api-key
QWEN_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 可选：记录百炼业务空间信息，仅供配置核对；不要写入前端构建变量。
QWEN_WORKSPACE_ID=
QWEN_WORKSPACE_NAME=
QWEN_API_MODE=dashscope-native
QWEN_PRIMARY_MODEL=qwen3-vl-flash
QWEN_FALLBACK_MODEL=qwen3.7-plus
QWEN_HIGH_ACCURACY_MODEL=qwen3-vl-plus
QWEN_ENABLE_THINKING=false
QWEN_TIMEOUT_MS=60000
QWEN_MAX_RETRIES=1
